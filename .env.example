# Copy to .env.local and fill in from Supabase → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...
# Server only. Project Settings -> Database -> Connection string (session
# pooler, with the database password). Used by npm run db:push.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Set to "supabase" to use real accounts and data instead of the preview.
NEXT_PUBLIC_AUTH_MODE=preview
