# The demo Supabase project (never production, rlopcnjufynbqdutzstt).
# Copy to .env.demo.local and fill in from the demo project's settings.
NEXT_PUBLIC_SUPABASE_URL=https://your-demo-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Used by npm run seed:demo.
SUPABASE_SECRET_KEY=sb_secret_...
# Project Settings -> Database -> Connection string (session pooler, with
# the database password). Used by npm run db:push:demo.
SUPABASE_DB_URL=postgresql://postgres.your-demo-ref:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Password for the three demo logins and the other seeded accounts.
DEMO_PASSWORD=choose-a-long-password
